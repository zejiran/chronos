{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronos",
  "version": "1.0.0",
  "identifier": "com.chronos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chronos",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A beautiful, performant calendar application",
    "longDescription": "Chronos is a cross-platform, open-source calendar application that rivals commercial products like Notion Calendar and Cron. Built with performance as the top priority using Tauri and Solid.js.",
    "copyright": "Copyright (c) 2025 Juan Alegría",
    "license": "GPL-3.0"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:chronos.db"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["chronos"]
      }
    }
  }
}
